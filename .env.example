# Copy to .env and change the values.  NEVER commit the real .env file.

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Key that encrypts bank account numbers and KYC documents. Generate once and KEEP SAFE:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this key is lost, encrypted KYC documents and account numbers cannot be read.
FIELD_ENCRYPTION_KEY=

POSTGRES_PASSWORD=rowms-change-me

# Hostnames the server answers to (comma separated), e.g. row.ipower.in,localhost
ALLOWED_HOSTS=*
# Full origins for the web admin when served over HTTPS, e.g. https://row.ipower.in
CSRF_TRUSTED_ORIGINS=
# true when the site is served over HTTPS (recommended); false for a plain-HTTP local pilot
SECURE_COOKIES=false

# Load the demo projects, farmers and users on first start (prototype only)
SEED_DEMO=true

# Optional: create/refresh a company administrator on start
ADMIN_USERNAME=
ADMIN_PASSWORD=

MAX_DOCUMENT_SIZE_MB=20
