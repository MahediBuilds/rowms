{
  "expo": {
    "name": "ROW Field",
    "slug": "rowms-field",
    "scheme": "rowfield",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.ipower.rowfield",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18242E"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ROW Field records the GPS position of poles, towers, land and crop inspections."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ROW Field takes site, crop and KYC document photos.",
          "photosPermission": "ROW Field attaches photos you choose to field records."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
